{
  "name": "@safescript/example-smart-building",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@safescript/contracts": "*",
    "@safescript/sdk": "*",
    "@xyflow/react": "12.8.6",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.54.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7"
  },
  "scripts": {
    "build:web": "bun build src/client/main.tsx --outdir dist/public --minify --sourcemap=external",
    "dev": "bun run build:web && bun src/server.ts",
    "test:browser": "playwright test",
    "test:integration": "bun test ./tests --timeout 120000"
  },
  "nx": {
    "tags": [
      "layer:example"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "bun run build:web && tsc -b tsconfig.lib.json",
          "cwd": "{projectRoot}"
        },
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "eslint src tests e2e playwright.config.ts",
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "bun run test:integration && bun run test:browser",
          "cwd": "{projectRoot}"
        }
      },
      "typecheck": {}
    }
  }
}
