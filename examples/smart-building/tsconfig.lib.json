{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "types": ["bun", "react", "react-dom"],
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"],
  "references": [
    { "path": "../../packages/contracts/tsconfig.lib.json" },
    { "path": "../../packages/sdk/tsconfig.lib.json" }
  ]
}
