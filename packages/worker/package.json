{
  "name": "@safescript/worker",
  "version": "2.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entry": "./dist/entry.js",
    "./manifest": "./dist/build-manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/build-manifest.json",
    "dist/entry.js",
    "dist/index.d.ts",
    "dist/index.js",
    "dist/protocol.d.ts",
    "dist/protocol.js",
    "dist/server.d.ts",
    "dist/server.js"
  ],
  "bin": {
    "safescript-worker": "./dist/entry.js"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@safescript/contracts": "2.0.0",
    "@safescript/engine": "2.0.0"
  },
  "nx": {
    "tags": [
      "layer:worker"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "tsc -b tsconfig.lib.json",
            "bun scripts/build.ts"
          ],
          "cwd": "packages/worker",
          "parallel": false
        },
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "lint": {},
      "test": {},
      "typecheck": {}
    }
  }
}
